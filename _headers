# Always revalidate the app shell + every JS/CSS module so a new deploy loads
# immediately (no stale cached module). Requires Cloudflare "Browser Cache TTL"
# to be set to "Respect Existing Headers" so these max-age=0 values are honored.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/config.js
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
# The mobile app reads this to decide whether to offer an update, and downloads
# the APK — both must never be served stale.
/download/app-version.json
  Cache-Control: no-cache, no-store, must-revalidate
/download/app-debug.apk
  Cache-Control: no-cache, no-store, must-revalidate
/walkie.html
  Cache-Control: public, max-age=0, must-revalidate
